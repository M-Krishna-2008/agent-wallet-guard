# ==============================================================================
# Agent Wallet Guard - Environment Configuration
# ==============================================================================

# PayPal Developer Sandbox Credentials
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_MOCK=false
# Mode: "payouts" (default, direct sandbox payout) or "orders" (fallback Orders v2 checkout)
PAYPAL_MODE=payouts
VENDOR_SANDBOX_EMAIL=sb-vendor@business.example.com

# Agent API Authentication
AGENT_API_KEY=your_agent_api_key_here

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///guard.db

# LLM Reasoning & Policy Guardrail Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3-flash-preview

# Application Runtime Flags
DEMO_MODE=true
AGENT_MODE=scripted
# Agent Tool Path: "rest" (default) or "mcp" (PayPal Model Context Protocol tools)
AGENT_TOOL=rest
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com
ALLOW_LIVE=false
